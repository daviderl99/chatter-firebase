rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/chatRooms/$(roomId)).data;
    }

    function isMember(roomId) {
      return signedIn() && request.auth.uid in room(roomId).members;
    }

    function isOwner(roomId) {
      return signedIn() && room(roomId).createdBy == request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // Per-room "last read" markers used for unread badges
      match /roomReads/{roomId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /chatRooms/{roomId} {
      // Needed so the create/join flows can look a room up by name
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && (
        // Join: anyone signed in may add only themselves
        (changedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() <= resource.data.members.size() + 1)
        // Leave: a member may remove only themselves
        || (request.auth.uid in resource.data.members
          && changedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
        // Upgrade a legacy plaintext password to a salted hash
        || (request.auth.uid in resource.data.members
          && resource.data.password is string
          && !('passwordHash' in resource.data)
          && !('passwordSalt' in resource.data)
          && !('passwordIterations' in resource.data)
          && changedKeys().hasOnly(['password', 'passwordHash', 'passwordSalt', 'passwordIterations'])
          && !('password' in request.resource.data)
          && request.resource.data.passwordHash is string
          && request.resource.data.passwordHash.matches('^[A-Za-z0-9+/]{43}=$')
          && request.resource.data.passwordSalt is string
          && request.resource.data.passwordSalt.matches('^[A-Za-z0-9+/]{22}==$')
          && request.resource.data.passwordIterations is int
          && request.resource.data.passwordIterations == 150000)
        // Owner: remove exactly one other member
        || (resource.data.createdBy == request.auth.uid
          && changedKeys().hasOnly(['members'])
          && request.auth.uid in request.resource.data.members
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1)
        // Owner: rename the room / change its image
        || (resource.data.createdBy == request.auth.uid
          && changedKeys().hasOnly(['name', 'photoURL']))
      );

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isMember(roomId);

        allow create: if isMember(roomId)
          && request.resource.data.uid == request.auth.uid;

        allow update: if isMember(roomId) && (
          // Anyone in the room can react
          changedKeys().hasOnly(['reactions'])
          // Only the author can edit
          || (resource.data.uid == request.auth.uid
            && changedKeys().hasOnly(['text', 'editedAt']))
        );

        // Authors can delete their own messages. The owner's branch exists only so
        // deleting a whole room can clear its messages; the UI doesn't offer it.
        allow delete: if isMember(roomId)
          && (resource.data.uid == request.auth.uid || isOwner(roomId));
      }

      match /typing/{userId} {
        allow read: if isMember(roomId);
        allow create, update: if isMember(roomId) && request.auth.uid == userId;
        allow delete: if isMember(roomId)
          && (request.auth.uid == userId || isOwner(roomId));
      }
    }
  }
}
